# ─────────────────────────────────────────────────────────────────────────
# Email Agentic Architecture — environment configuration template.
# Copy to .env and fill in real values. NEVER commit the real .env file,
# credentials JSON, or token JSON files — see DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────
# sqlite (default, dev-friendly, single container):
DATABASE_URL=sqlite:////app/data/email_agent.db
# postgres (recommended for multi-user production — see docker-compose.yml
# `postgres` profile):
# DATABASE_URL=postgresql://email_agent:email_agent@postgres:5432/email_agent

# ── Google OAuth (Gmail + Google Calendar) ─────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Path to the OAuth client JSON downloaded from Google Cloud Console
# (Desktop or Web application type). Mount into ./secrets, see docker-compose.yml.
GOOGLE_CREDENTIALS_PATH=/app/secrets/google_credentials.json
# Where the provider caches the refresh/access token after first login.
GOOGLE_TOKEN_PATH=/app/secrets/google_token.json

# ── Microsoft Entra (Outlook + Outlook/Teams Calendar) ─────────────────
MICROSOFT_CLIENT_ID=your-azure-ad-app-client-id
MICROSOFT_TENANT_ID=common

# ── Email/Calendar provider defaults for newly-created users (specs v3 §9.2) ──
DEFAULT_EMAIL_PROVIDER=gmail        # gmail | outlook
DEFAULT_CALENDAR_PROVIDER=google    # google | outlook
# Comma-separated org domain(s), used as the Internal-relationship signal.
ORG_DOMAINS=

# ── LLM provider (Stage 1/2 reasoning) ─────────────────────────────────
LLM_PROVIDER=ollama                 # ollama | openai | gemini
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=30
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ── Embeddings (specs v3 §5.3, §9.1) ────────────────────────────────────
# Recommended: pin independently of LLM_PROVIDER so swapping the reasoning
# model doesn't reset the combined-distribution semantic space.
EMBEDDING_PROVIDER=ollama           # ollama | openai | gemini
EMBEDDING_MODEL=nomic-embed-text    # text-embedding-3-small (openai) / text-embedding-004 (gemini)

# ── Pipeline tuning ──────────────────────────────────────────────────────
MAX_EMAILS_PER_RUN=500
DRY_RUN=false
ENABLE_CALENDAR=true

# ── Scheduler (app/scheduler/scheduler.py) ──────────────────────────────
ENABLE_SCHEDULER=true
BATCH_INTERVAL_MINUTES=60
RECONCILIATION_INTERVAL_MINUTES=120
THREAD_MEMORY_EXPIRY_INTERVAL_HOURS=24
MEETING_PURGE_INTERVAL_HOURS=24
MEETING_STALE_DAYS=14

# ── Local dev seed user (app/db/database.py:seed_test_user) ────────────
GMAIL_EMAIL=you@example.com

# ── Frontend build-time config (frontend/Dockerfile ARG, docker-compose.yml) ──
VITE_API_BASE=http://localhost:8000
